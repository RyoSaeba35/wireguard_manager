  }

  @media (max-width: 768px) {
    .faq {
      padding: 2rem 0.5rem;
    }

    .faq-question {
      font-size: 1rem;
      padding: 1rem 0;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.innerWidth <= 768) {
      const sliderElement = document.getElementById('plan-slider');
      if (sliderElement && !sliderElement.classList.contains('isinitialized')) {
        sliderElement.classList.add('isinitialized');
        const splide = new Splide('#plan-slider', {
          type: 'slide',
          perPage: 1,
          gap: '1rem',
          padding: '1rem',
          arrows: true,
          pagination: false,
        });
        splide.mount();
      }
    }
  });

  function toggleFaq(button) {
    const item = button.parentElement;
    const answer = item.querySelector('.faq-answer');
    const isOpen = item.classList.contains('open');

    // Close all open items
    document.querySelectorAll('.faq-item.open').forEach(function(openItem) {
      openItem.classList.remove('open');
      openItem.querySelector('.faq-answer').style.display = 'none';
    });

    // Open clicked item if it was closed
    if (!isOpen) {
      item.classList.add('open');
      answer.style.display = 'block';
    }
  }
</script>
