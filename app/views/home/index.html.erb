          </ul>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(this)">
          <%= t('home.faq.devices.question') %>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p><%= t('home.faq.devices.answer_1').html_safe %></p>
          <p><%= t('home.faq.devices.answer_2') %></p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(this)">
          <%= t('home.faq.banking.question') %>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p><%= t('home.faq.banking.answer_1').html_safe %></p>
          <p><%= t('home.faq.banking.answer_2').html_safe %></p>
          <p><%= t('home.faq.banking.answer_3') %></p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(this)">
          <%= t('home.faq.servers.question') %>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p><%= t('home.faq.servers.answer_1').html_safe %></p>
          <p><%= t('home.faq.servers.answer_2') %></p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(this)">
          <%= t('home.faq.speed.question') %>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p><%= t('home.faq.speed.answer_1').html_safe %></p>
          <p><%= t('home.faq.speed.answer_2') %></p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(this)">
          <%= t('home.faq.legal.question') %>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
