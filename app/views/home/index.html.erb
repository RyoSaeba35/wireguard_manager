<div class="super-container">
  <section class="hero">
    <h1><%= t('home.hero.title') %><br><%= t('home.hero.subtitle') %></h1>
    <p><%= t('home.hero.description') %></p>
    <a href="<%= new_user_registration_path %>" class="cta-btn"><%= t('home.hero.cta') %></a>
  </section>

  <section class="features">
    <h2><%= t('home.features.title') %></h2>
    <div class="feature-grid">
      <div class="feature-card">
        <h3><%= t('home.features.reliable.title') %></h3>
        <p><%= t('home.features.reliable.description') %></p>
      </div>
      <div class="feature-card">
        <h3><%= t('home.features.no_oversell.title') %></h3>
        <p><%= t('home.features.no_oversell.description') %></p>
      </div>
      <div class="feature-card">
        <h3><%= t('home.features.privacy.title') %></h3>
        <p><%= t('home.features.privacy.description') %></p>
      </div>
    </div>
  </section>

  <section class="pricing">
    <h2><%= t('home.pricing.title') %></h2>
    <!-- Desktop Grid -->
    <div class="plan-grid">
      <% @plans.each do |plan| %>
        <div class="plan">
          <% if plan.interval == "month" %>
            <div class="popular-badge"><%= t('home.pricing.popular') %></div>
          <% end %>
          <h3><%= plan.localized_name %></h3>
          <p class="plan-subtitle"><%= t('home.pricing.subtitle') %></p>
          <div class="plan-price">€<%= plan.price %>/<%= plan.interval %></div>
          <div class="plan-features">
            <% plan.localized_description.split(', ').each do |feature| %>
              <p><strong><span class="checkmark">➤</span> <%= feature %></strong></p>
            <% end %>
          </div>
          <a href="<%= new_user_registration_path %>" class="plan-btn"><%= t('home.pricing.sign_up') %></a>
        </div>
      <% end %>
    </div>
    <!-- Mobile Carousel -->
    <div class="splide" id="plan-slider">
      <div class="splide__track">
        <div class="splide__list">
          <% @plans.each do |plan| %>
            <div class="splide__slide">
              <div class="plan">
                <% if plan.interval == "month" %>
                  <div class="popular-badge"><%= t('home.pricing.popular') %></div>
                <% end %>
                <h3><%= plan.localized_name %></h3>
                <p class="plan-subtitle"><%= t('home.pricing.subtitle') %></p>
                <div class="plan-price">€<%= plan.price %>/<%= plan.interval %></div>
                <div class="plan-features">
                  <% plan.localized_description.split(', ').each do |feature| %>
                    <p><strong><span class="checkmark">➤</span> <%= feature %></strong></p>
                  <% end %>
                </div>
                <a href="<%= new_user_registration_path %>" class="plan-btn"><%= t('home.pricing.sign_up') %></a>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Downloads Section -->
  <section class="downloads">
    <h2><%= t('home.downloads.title') %></h2>
    <p class="downloads-subtitle"><%= t('home.downloads.subtitle') %><br>
    <small class="downloads-subtitle"><%= t('home.downloads.coming_soon') %></small></p>
    <div class="download-buttons">
      <a href="<%= download_windows_path %>" class="download-badge-link">
        <img src="/windows-button.png"
            alt="Download for Windows"
            class="download-badge google-play-badge">
      </a>
      <a href="YOUR_GOOGLE_PLAY_STORE_URL" class="download-badge-link">
        <img src="/googleplay-button.png"
            alt="Get it on Google Play"
            class="download-badge google-play-badge">
      </a>
    </div>
  </section>

  <!-- About Us Section -->
  <section class="about-us">
    <h2><%= t('home.about.title') %></h2>
    <div class="about-content">
      <p class="about-intro"><%= t('home.about.intro').html_safe %></p>
      <p><%= t('home.about.body').html_safe %></p>

      <div class="about-highlight">
        <h3><%= t('home.about.highlight_title') %></h3>
        <p><span class="checkmark">➤</span> <%= t('home.about.small_by_design').html_safe %></p>
        <p><span class="checkmark">➤</span> <%= t('home.about.built_for_expats').html_safe %></p>
        <p><span class="checkmark">➤</span> <%= t('home.about.focus').html_safe %></p>
      </div>

      <p class="about-closing"><%= t('home.about.closing') %></p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq">
    <h2><%= t('home.faq.title') %></h2>
    <div class="faq-list">

      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(this)">
