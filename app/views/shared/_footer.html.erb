<footer class="footer">
  <div class="footer-links">
    <%= link_to t('footer.privacy'), privacy_path %>
    <%= link_to t('footer.terms'), terms_path %>
    <%= link_to t('footer.logging'), logging_path %>
  </div>
  <div class="footer-links footer-resources">
    <%= link_to (I18n.locale == :fr ? "VPN pour expats" : "VPN for expats"), blog_vpn_expats_path %>
    <%= link_to (I18n.locale == :fr ? "VPN sans logs" : "VPN no browsing logs"), blog_vpn_logs_path %>
    <%= link_to (I18n.locale == :fr ? "VPN en voyage" : "VPN while travelling"), blog_vpn_voyage_path %>
  </div>
  <p class="footer-copyright"><%= t('footer.copyright') %></p>
</footer>

<style>
  .footer {
    background-color: #432923;
    color: white;
    text-align: center;
    padding: 2rem;
    margin-top: auto;
    position: relative;
    z-index: 20;
  }
  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .footer-links a {
    color: white;
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
  .footer-resources {
    opacity: 0.75;
    font-size: 0.85rem;
  }
  .footer-copyright {
    margin: 0 auto;
    text-align: center;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
  }
  @media (max-width: 480px) {
    .footer {
      padding: 1rem;
    }
    .footer-links {
      flex-direction: column;
      gap: 0.75rem;
    }
    .footer-links a {
      font-size: 0.85rem;
    }
    .footer-copyright {
      font-size: 0.8rem;
    }
  }
</style>
