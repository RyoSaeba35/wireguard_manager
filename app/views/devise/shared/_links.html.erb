<%- if controller_name != 'sessions' %>
  <%= link_to (I18n.locale == :fr ? 'Se connecter' : 'Log In'), new_session_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to (I18n.locale == :fr ? "S'inscrire" : 'Sign Up'), new_registration_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to (I18n.locale == :fr ? 'Mot de passe oublié ?' : 'Forgot your password?'), new_password_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to (I18n.locale == :fr ? "Vous n'avez pas reçu les instructions de confirmation ?" : "Didn't receive confirmation instructions?"), new_confirmation_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to (I18n.locale == :fr ? "Vous n'avez pas reçu les instructions de déverrouillage ?" : "Didn't receive unlock instructions?"), new_unlock_path(resource_name) %><br />
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= button_to "#{I18n.locale == :fr ? 'Se connecter avec' : 'Sign in with'} #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false } %><br />
  <% end %>
<% end %>

