<style>
  .signup-super-container {
    font-family: 'Arial', sans-serif;
    background-color: #f4f4f4;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .signup-container {
    background-color: white;
    padding: 2rem;
    margin: 1rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 400px;
  }
  .signup-container h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    color: #2c3e50;
  }
  .form-group {
    margin-bottom: 1rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: #333;
  }
  .form-group input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
  }
  .form-group input:focus {
    border-color: #ff6e08;
    outline: none;
  }
  .signup-btn {
    width: 100%;
    background-color: #ff6e08;
    color: white;
    padding: 0.75rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    margin-top: 1rem;
  }
  .signup-btn:hover {
    background-color: #ffc33c;
  }
  .login-link {
    text-align: center;
    margin-top: 1rem;
    color: #e74c3c;
  }
  .login-link a {
    color: #432923;
    text-decoration: none;
  }
  .login-link a:hover {
    color: #ffc33c;
    text-decoration: none;
  }
</style>

<div class="signup-super-container">
  <div class="signup-container">
    <h2><%= t('auth.sign_up.title') %></h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.label :email, t('auth.sign_up.email') %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: t('auth.sign_up.email') %>
      </div>

      <div class="form-group">
        <%= f.label :password, t('auth.sign_up.password') %>
        <%= f.password_field :password, autocomplete: "new-password", required: true, placeholder: t('auth.sign_up.password') %>
        <% if @minimum_password_length %>
          <small><%= t('auth.sign_up.password') %> (<%= @minimum_password_length %> min.)</small>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, t('auth.sign_up.password_confirmation') %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, placeholder: t('auth.sign_up.password_confirmation') %>
      </div>

      <div class="actions">
        <%= f.submit t('auth.sign_up.submit'), class: "signup-btn" %>
      </div>
    <% end %>

    <div class="login-link">
      <%= t('auth.sign_up.already_account') %> <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
