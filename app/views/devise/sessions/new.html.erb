<style>
  .login-super-container {
    font-family: 'Arial', sans-serif;
    background-color: #f4f4f4;
    margin: auto;
    padding: auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .login-container {
    background-color: white;
    padding: 2rem;
    margin: 1rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 400px;
  }
  .login-container h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    color: #2c3e50;
  }
  .form-group {
    margin-bottom: 1rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: #333;
  }
  .form-group input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
  }
  .form-group input:focus {
    border-color: #ff6e08;
    outline: none;
  }
  .form-group input[type="checkbox"] {
    width: auto;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  .form-group label[for="user_remember_me"] {
    display: inline;
    vertical-align: middle;
    margin-bottom: 0;
  }
  .login-btn {
    width: 100%;
    background-color: #ff6e08;
    color: white;
    padding: 0.75rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    margin-top: 1rem;
  }
  .login-btn:hover {
    background-color: #ffc33c;
  }
  .signup-link {
    text-align: center;
    margin-top: 1rem;
    color: #e74c3c;
  }
  .signup-link a {
    color: #432923;
    text-decoration: none;
  }
  .signup-link a:hover {
    color: #ffc33c;
  }

  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .password-wrapper input {
    width: 100%;
    padding-right: 3rem;
    box-sizing: border-box;
  }

  .password-toggle {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #999;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .password-toggle:hover {
    color: #ff6e08;
  }
</style>

<div class="login-super-container">
  <div class="login-container">
    <h2><%= t('auth.sign_in.title') %></h2>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, t('auth.sign_in.email') %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: t('auth.sign_in.email') %>
      </div>

      <div class="form-group" data-controller="password-toggle">
        <%= f.label :password, t('auth.sign_in.password') %>
        <div class="password-wrapper">
          <%= f.password_field :password,
              autocomplete: "current-password",
              required: true,
              placeholder: t('auth.sign_in.password'),
              data: { "password-toggle-target": "field" } %>
          <button type="button"
                  class="password-toggle"
                  data-password-toggle-target="button"
                  data-action="click->password-toggle#toggle"
                  aria-label="Show password">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group">
          <div>
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, t('auth.sign_in.remember_me') %>
          </div>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit t('auth.sign_in.submit'), class: "login-btn" %>
      </div>
    <% end %>

    <div class="signup-link">
      <%= t('auth.sign_in.no_account') %> <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
